### Order Management API Requests
# Use this file to test order endpoints in IntelliJ IDEA or VS Code REST Client.

@host = http://localhost:8080
@orderId = 33333333-3333-3333-3333-333333333333
@productId = 11111111-1111-1111-1111-111111111111

### 1. Create Order (201 Created)
POST {{host}}/v1/orders
Content-Type: application/json

{
  "id": "{{orderId}}",
  "customerName": "Jane Doe",
  "customerEmail": "jane.doe@example.com",
  "currency": "EUR",
  "deliveryAddress": {
    "name": "Jane Doe",
    "telephone": "+34-91-123-4567",
    "street": "123 Gran Via",
    "complement": "Apt 4B",
    "city": "Madrid",
    "state": "Madrid",
    "zipCode": "28013",
    "country": "Spain"
  },
  "invoiceAddress": {
    "name": "Jane Doe",
    "vatNumber": "ES12345678Z",
    "telephone": "+34-91-123-4567",
    "street": "123 Gran Via",
    "complement": "Apt 4B",
    "city": "Madrid",
    "state": "Madrid",
    "zipCode": "28013",
    "country": "Spain"
  },
  "orderLines": [
    {
      "productId": "{{productId}}",
      "quantity": 2,
      "unitPriceInCents": 12999
    }
  ]
}

### 2. Retrieve Order by Identifier (200 OK)
GET {{host}}/v1/orders/{{orderId}}
Accept: application/json

### 3. Update Existing Order (200 OK)
PUT {{host}}/v1/orders/{{orderId}}
Content-Type: application/json

{
  "customerName": "Jane Doe Updated",
  "customerEmail": "jane.doe@example.com",
  "date": "2026-11-12T08:00:00Z",
  "status": "PENDING",
  "currency": "EUR",
  "deliveryAddress": {
    "name": "Jane Doe Updated",
    "telephone": "+34-91-123-4567",
    "street": "456 Paseo de la Castellana",
    "complement": "Floor 3",
    "city": "Madrid",
    "state": "Madrid",
    "zipCode": "28046",
    "country": "Spain"
  },
  "invoiceAddress": {
    "name": "Jane Doe Updated",
    "vatNumber": "ES12345678Z",
    "telephone": "+34-91-123-4567",
    "street": "456 Paseo de la Castellana",
    "complement": "Floor 3",
    "city": "Madrid",
    "state": "Madrid",
    "zipCode": "28046",
    "country": "Spain"
  },
  "orderLines": [
    {
      "productId": "{{productId}}",
      "quantity": 3,
      "unitPriceInCents": 12999
    }
  ]
}

### 4. List Orders (200 OK)
GET {{host}}/v1/orders?limit=10&offset=0
Accept: application/json

### 5. Create Order - Validation Error (400 Bad Request)
POST {{host}}/v1/orders
Content-Type: application/json

{
  "id": "44444444-4444-4444-4444-444444444444",
  "customerName": "",
  "customerEmail": "invalid-email-address",
  "currency": "INVALID",
  "deliveryAddress": {
    "name": "",
    "telephone": "",
    "street": "",
    "city": "",
    "state": "",
    "zipCode": "",
    "country": ""
  },
  "invoiceAddress": {
    "name": "",
    "vatNumber": "",
    "telephone": "",
    "street": "",
    "city": "",
    "state": "",
    "zipCode": "",
    "country": ""
  },
  "orderLines": []
}

