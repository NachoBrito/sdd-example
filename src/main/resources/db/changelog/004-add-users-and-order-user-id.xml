            <column name="created_at" valueDate="2026-11-13T00:00:00"/>
            <column name="updated_at" valueDate="2026-11-13T00:00:00"/>
        </insert>
        <insert tableName="user_roles">
            <column name="user_id" value="00000000-0000-0000-0000-000000000002"/>
            <column name="role" value="ADMIN"/>
        </insert>
        <insert tableName="user_roles">
            <column name="user_id" value="00000000-0000-0000-0000-000000000002"/>
            <column name="role" value="CUSTOMER"/>
        </insert>
        <insert tableName="user_roles">
            <column name="user_id" value="00000000-0000-0000-0000-000000000002"/>
            <column name="role" value="CATALOG"/>
        </insert>

        <insert tableName="users">
            <column name="id" value="00000000-0000-0000-0000-000000000003"/>
