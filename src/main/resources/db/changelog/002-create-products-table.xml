<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-products-table" author="antigravity">
        <createTable tableName="products">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_products"/>
            </column>
            <column name="sku" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_products_sku"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="price_in_cents" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="CHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE products ADD CONSTRAINT chk_products_price CHECK (price_in_cents >= 0);
        </sql>

        <createIndex tableName="products" indexName="idx_products_status">
            <column name="status"/>
        </createIndex>

        <createIndex tableName="products" indexName="idx_products_created_at">
            <column name="created_at"/>
        </createIndex>

        <rollback>
            <dropTable tableName="products"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

