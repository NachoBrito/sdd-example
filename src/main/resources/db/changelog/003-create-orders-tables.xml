<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-create-orders-tables" author="antigravity">
        <createTable tableName="orders">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_orders"/>
            </column>
            <column name="customer_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="customer_email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="order_date" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount_in_cents" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="CHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="delivery_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="delivery_telephone" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="delivery_street" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="delivery_complement" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="delivery_city" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="delivery_state" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="delivery_zip_code" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="delivery_country" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="invoice_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="invoice_vat_number" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="invoice_telephone" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="invoice_street" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="invoice_complement" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="invoice_city" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="invoice_state" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="invoice_zip_code" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="invoice_country" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE orders ADD CONSTRAINT chk_orders_total CHECK (total_amount_in_cents >= 0);
        </sql>

        <createIndex tableName="orders" indexName="idx_orders_status">
            <column name="status"/>
        </createIndex>

        <createIndex tableName="orders" indexName="idx_orders_customer_email">
            <column name="customer_email"/>
        </createIndex>

        <createIndex tableName="orders" indexName="idx_orders_order_date">
            <column name="order_date"/>
        </createIndex>

        <createTable tableName="order_lines">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_order_lines"/>
            </column>
            <column name="order_id" type="VARCHAR(36)">
                <constraints nullable="false" foreignKeyName="fk_order_lines_order" references="orders(id)"/>
            </column>
            <column name="product_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="unit_price_in_cents" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="line_total_in_cents" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE order_lines ADD CONSTRAINT chk_order_lines_quantity CHECK (quantity > 0);
            ALTER TABLE order_lines ADD CONSTRAINT chk_order_lines_unit_price CHECK (unit_price_in_cents >= 0);
            ALTER TABLE order_lines ADD CONSTRAINT chk_order_lines_total CHECK (line_total_in_cents >= 0);
        </sql>

        <createIndex tableName="order_lines" indexName="idx_order_lines_order_id">
            <column name="order_id"/>
        </createIndex>

        <createIndex tableName="order_lines" indexName="idx_order_lines_product_id">
            <column name="product_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="order_lines"/>
            <dropTable tableName="orders"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

