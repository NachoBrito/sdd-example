<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="005-add-categories-and-campaigns" author="antigravity">
        <createTable tableName="categories">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_categories"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <createIndex tableName="categories" indexName="idx_categories_name">
            <column name="name"/>
        </createIndex>

        <addColumn tableName="products">
            <column name="category_id" type="VARCHAR(36)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addForeignKeyConstraint
            baseTableName="products"
            baseColumnNames="category_id"
            constraintName="fk_products_category"
            referencedTableName="categories"
            referencedColumnNames="id"
            onDelete="RESTRICT"/>

        <createIndex tableName="products" indexName="idx_products_category_id">
            <column name="category_id"/>
        </createIndex>

        <createTable tableName="campaigns">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_campaigns"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="start_date" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="end_date" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="discount_percent" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE campaigns ADD CONSTRAINT chk_campaigns_discount_percent
                CHECK (discount_percent &gt;= 0 AND discount_percent &lt;= 100);
            ALTER TABLE campaigns ADD CONSTRAINT chk_campaigns_date_range
                CHECK (end_date &gt;= start_date);
        </sql>

        <createIndex tableName="campaigns" indexName="idx_campaigns_status_dates">
            <column name="status"/>
            <column name="start_date"/>
            <column name="end_date"/>
        </createIndex>

        <createTable tableName="campaign_predicates">
            <column name="id" type="VARCHAR(36)">
                <constraints
                    primaryKey="true"
                    nullable="false"
                    primaryKeyName="pk_campaign_predicates"/>
            </column>
            <column name="campaign_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="predicate_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="predicate_value" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="campaign_predicates"
            baseColumnNames="campaign_id"
            constraintName="fk_campaign_predicates_campaign"
            referencedTableName="campaigns"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <createIndex tableName="campaign_predicates" indexName="idx_campaign_predicates_campaign_id">
            <column name="campaign_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="campaign_predicates"/>
            <dropTable tableName="campaigns"/>
            <dropForeignKeyConstraint baseTableName="products" constraintName="fk_products_category"/>
            <dropIndex tableName="products" indexName="idx_products_category_id"/>
            <dropColumn tableName="products" columnName="category_id"/>
            <dropTable tableName="categories"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

